{
  "name": "enviador-whatsapp",
  "productName": "CRM HERMES",
  "version": "4.3.3",
  "description": "CRM HERMES · Conecta Salud",
  "author": "Conecta Salud",
  "main": "arranque.js",
  "scripts": {
    "postinstall": "node build/aplicar-parches.js",
    "start": "electron .",
    "build": "node build/liviana.js huella && electron-builder --win nsis --publish never && node build/liviana.js paquete",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "sql.js": "^1.13.0",
    "whatsapp-web.js": "1.34.7",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.20",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "cl.conectasalud.enviador",
    "productName": "CRM HERMES",
    "directories": { "output": "dist" },
    "files": ["arranque.js", "liviana.js", "huella.json", "main.js", "preload.js", "server.js", "db.js", "meta.js", "auth.js", "tandas.js", "carriles.js", "llamadas.js", "temas.js", "uf.js", "anualidad.js", "documentos.js", "public/**", "package.json", "node_modules/**", "build/icon.png", "build/icon.ico", "build/carpeta.ico"],
    "win": { "target": "nsis", "icon": "build/icon.ico", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM HERMES",
      "artifactName": "Instalar-CRM-HERMES.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "CRM HERMES"
    },
    "asar": false,
    "publish": [{ "provider": "github", "owner": "Sestakova", "repo": "crm-max", "releaseType": "release" }],
    "afterPack": "build/afterPack.js"
  },
  "updateRepo": "Sestakova/crm-max"
}
